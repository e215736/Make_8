#:kivy 1.1
#:import Factory kivy.factory.Factory

<TitleScreen>:
    BoxLayout:
        canvas.before:
            Color:
                rgba:(240/255,240/255,240/255,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            Label:
                text:'Make8'
                font_size: '200'
                color:(20/255,32/255,40/255,1)
            BoxLayout:
                size_hint_y: 0.5
                Button:
                    text: 'スタート！'
                    font_size: '100'
                    on_press: root.manager.current = 'main'
                    color: 0, 0, 2, 1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                
            BoxLayout:
                size_hint_y: 0.5
                Button:
                    text: 'おわる'
                    font_size: '100'
                    on_press : app.stop()
                    color: 0, 0, 2, 1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)

<MainScreen>:
    BoxLayout:
        canvas.before:
            Color:
                rgba:(240/255,240/255,240/255,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            Button:
                text:'諦める！'
                size_hint_y:0.1
                size_hint_x:0.1
                on_press: root.manager.current = 'retire'
                background_normal: ""
                #RGBA
                background_color: (1,0,0,1)
            Label:
                text:'question'
                font_size: '100'
                color:(20/255,32/255,40/255,1)
            Label:
                text:'input value'
                font_size: '100'
                background_color: ((20/255,32/255,40/255,1))
                canvas.before:
                    Color:
                        rgba: self.background_color
                    Rectangle:
                        pos: self.pos
                        size: self.size
            BoxLayout:
                size_hint_y: 0.5
                Button:
                    text: '1'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '2'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '3'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '4'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: 'DEL'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)

            BoxLayout:
                size_hint_y: 0.5
                Button:
                    text: '+'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '-'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '*'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: '/'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
                Button:
                    text: 'OK'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    on_release: Factory.MyPopup().open()
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)


<RetireScreen>
    BoxLayout:
        canvas.before:
            Color:
                rgba:(240/255,240/255,240/255,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            Label:
                text:'答えは...'
                font_size: '70'
                color: (1,0,0,1)
            Label:
                text:'2+2+2+2'
                font_size: '70'
                color: (1,0,0,1)

            Label:
                text:'(他にも答えがあるかもしれません)'
                font_size: '70'
                color: (1,0,0,1)

            BoxLayout:

                Button:
                    text: 'タイトルへ'
                    on_press: root.manager.current = 'title'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)

<CorrectScreen>
    BoxLayout:
        canvas.before:
            Color:
                rgba:(240/255,240/255,240/255,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            Label:
                text:'CLEAR!!'
                font_size: '100'
                color: (1,0,0,1)
            BoxLayout:
                size_hint_y: 0.4
                Button:
                    text: '次の問題へ'
                    on_press: root.manager.current = 'main'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)
            BoxLayout:
                size_hint_y: 0.4
                Button:
                    text: 'タイトルへ'
                    on_press: root.manager.current = 'title'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)

<AllCorrectScreen>
    BoxLayout:
        canvas.before:
            Color:
                rgba:(240/255,240/255,240/255,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            Label:
                text:'CONGRATULATIONS!!'
                font_size: '100'
                color: (1,0,0,1)

            BoxLayout:
                size_hint_y: 0.2
                Button:
                    text: 'タイトルへ'
                    on_press: root.manager.current = 'title'
                    font_size: '100'
                    color: 20/255,32/255,40/255,1
                    background_normal: ""
                    #RGBA
                    background_color: (41/255,231/255,205/255,1)

<MyPopup@Popup>:
    auto_dismiss: False
    size_hint: .5, .5
    pos_hint: {'center_x': .5, 'center_y': .5}
    title: 'まだやれる！がんばれ！'
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'your answer is wrong'
        Button:
            size_hint_y: None
            height: 80
            text: '閉じて問題に戻る'
            on_release: root.dismiss()

